NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # worker only, never client
GROQ_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000

# Shared secret the finalize route uses to wake the worker route.
WORKER_SECRET=

# Guards the Resend delivery webhook. Configure the endpoint in Resend as
# {APP_URL}/api/webhooks/resend?key={RESEND_WEBHOOK_SECRET}
# With this unset the webhook rejects everything, which is the safe default.
RESEND_WEBHOOK_SECRET=

# Optional. §2 names qwen-3-32b, which Groq retired; the default is the
# current Qwen on Groq. Set this to pin a different one.
GROQ_NOTES_MODEL=
